# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules/
bot/node_modules/

# Build output
dist/
dist-ssr/
*.local

# Environment variables and secrets
.env
bot/.env
bot/firebase-service-account.json
firebase-service-account.json

# WhatsApp / Baileys session files
bot/auth_info/
bot/auth_info_baileys/
**/auth_info/
**/auth_info_baileys/

# Runtime-generated files
uploads/
bot/uploads/
bot/data/

# Generated evaluation reports (regenerate with `npm run evaluation`)
evaluation/reports/*.json

# Generated test coverage reports (regenerate with `npm run coverage`)
coverage/
bot/coverage/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?


printf "\n# Secrets and local authentication\n.env\nfirebase-service-account.json\nauth_info/\nuploads/\n" >> .gitignore
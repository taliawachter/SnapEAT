OPENAI_API_KEY=your_openai_api_key
OPENAI_VECTOR_STORE_ID=
OPENAI_MODEL=
OPENAI_FILE_SEARCH_MAX_RESULTS=5
FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
ALLOWED_CHATS=9725XXXXXXXX
PAIRING_PHONE=9725XXXXXXXX
PORT=3000

# Number of new eligible messages required before creating a summary
CONVERSATION_SUMMARY_THRESHOLD=20

# Number of recent eligible messages used for reply memory context
MEMORY_RECENT_MESSAGES_LIMIT=8

# Minimum confidence required for long-term memory updates
MEMORY_UPDATE_MIN_CONFIDENCE=0.75

# Higher confidence threshold required for removing allergies/sensitivities
MEMORY_SAFETY_REMOVAL_MIN_CONFIDENCE=0.95

# Optional: identifies SNAP EAT to the Open Food Facts API (no API key required)
OPEN_FOOD_FACTS_USER_AGENT=SNAP-EAT/1.0